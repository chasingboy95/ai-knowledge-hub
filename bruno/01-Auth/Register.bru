meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@example.com",
    "password": "Password123!",
    "full_name": "Admin User"
  }
}

vars:post-response {
  token: res.body.access_token
  refreshToken: res.body.refresh_token
}
