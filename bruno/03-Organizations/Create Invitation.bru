meta {
  name: Create Invitation
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "teammate@example.com",
    "role": "EDITOR"
  }
}

vars:post-response {
  inviteToken: res.body.invite_token
}
