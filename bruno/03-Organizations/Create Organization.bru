meta {
  name: Create Organization
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/organizations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Acme Corp",
    "slug": "acme-corp"
  }
}

vars:post-response {
  organizationId: res.body.id
}
