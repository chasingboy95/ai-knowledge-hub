meta {
  name: Create Workspace
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/workspaces
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Engineering Workspace",
    "slug": "engineering"
  }
}

vars:post-response {
  workspaceId: res.body.id
}
