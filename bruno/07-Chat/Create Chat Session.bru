meta {
  name: Create Chat Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{orgId}}/workspaces/{{workspaceId}}/chat/sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "系统架构咨询对话"
  }
}

script:post-response {
  if (res.getStatus() === 201 && res.getBody() && res.getBody().id) {
    bru.setEnvVar("sessionId", res.getBody().id);
  }
}
