POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_knowledge_hub
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_knowledge_hub

# Development-only example value; replace this before any non-local deployment.
JWT_SECRET_KEY=change-me-in-development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage Settings (local | s3)
STORAGE_DIR=./data/storage
# STORAGE_PROVIDER=local
# S3_BUCKET=ai-knowledge-hub
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Document Chunking Settings (chonkie | native)
# CHUNKING_PROVIDER=chonkie
# CHUNKING_STRATEGY=sentence
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64

# Embedding Model Settings (openai | mock)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=lm-studio
EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024

# LLM Generation Settings (openai | mock)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:1235/v1
# LLM_MODEL=qwen3.5-4b-mlx
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=2048
# LLM_FREQUENCY_PENALTY=0.5
# LLM_PRESENCE_PENALTY=0.3

# Reranker Settings (qwen | mock)
# RERANKER_PROVIDER=qwen
# RERANKER_MODEL=qwen3-reranker-0.6b
# RERANKER_BASE_URL=http://localhost:1235/v1
# RERANKER_ENABLED=true
# RERANKER_CANDIDATE_TOP_K=15
